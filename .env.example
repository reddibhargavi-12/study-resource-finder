# ========================================================
# Study Resource Finder - Environment Configuration
# ========================================================

# --- Backend Configuration ---
PORT=5000

# Google Gemini API Key (Optional for free tier demo - mock fallback activates automatically if empty)
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Atlas Connection String (Optional - falls back smoothly to in-memory/localStorage demo mode)
MONGO_URI=

# JWT Secret for student authentication
JWT_SECRET=study_resource_finder_secret_key_2026

# Client Origin (CORS)
CLIENT_URL=http://localhost:5173

# --- Frontend Configuration ---
VITE_API_URL=http://localhost:5000/api
